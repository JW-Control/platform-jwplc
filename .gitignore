# JWPLC - artefactos locales de benchmarks
#
# Los scripts, sketches y documentos de tools/build-speed-benchmark se versionan.
# Los directorios *-work/ contienen builds, logs, objetos, mapas y resultados
# preservados localmente durante las mediciones y no deben entrar al repositorio.
/tools/build-speed-benchmark/*-work/
/tools/build-speed-benchmark/results/

# Overlay local generado durante los pilotos de core precompilado P2.
# La configuracion definitiva debe vivir en boards.txt, no en boards.local.txt.
/JWPLC/2.1.0/boards.local.txt

# JWPLC HMI Designer - productos y dependencias generadas localmente.
# Se versionan las fuentes, el icono fuente y electron/package-lock.json;
# no se versionan outputs de build ni node_modules.
/tools/jwplc-hmi-designer/dist/
/tools/jwplc-hmi-designer/electron/build/
/tools/jwplc-hmi-designer/electron/node_modules/
/tools/jwplc-hmi-designer/electron/release/

# Carpeta que genera la extensión CMake Tools de VS Code al abrir el repo
# (configura JWPLC/2.1.0/CMakeLists.txt con MSVC). No es parte del package.
/build/

# Scripts temporales de trabajo (no versionar; CLAUDE.md §5)
/scratch/

# Salidas de «Exportar binario compilado» del Arduino IDE dentro de los gates
# (el hook savehex del package copia .bin/.elf/.map/sdkconfig a <sketch>/build/).

/tools/jwplc-hmi-designer/tests/golden/*.actual.h
