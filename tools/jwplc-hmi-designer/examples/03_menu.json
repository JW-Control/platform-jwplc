{
  "$schema": "../schema/jwhmi.schema.json",
  "projectName": "Ejemplo_Menu",
  "display": { "start": "IDLE", "wake": "ANY", "back": "TIMEOUT", "timeoutS": 60 },
  "pages": [
    {
      "name": "Ajustes",
      "fields": [
        {
          "type": "MENU", "id": "MENU_AJUSTES", "title": "Ajustes", "x": 4, "y": 4, "width": 312, "height": 160,
          "nodes": [
            { "type": "VIEW", "label": "Temperatura", "variable": "temperatura", "valueType": "float", "decimals": 1, "unit": "C" },
            { "type": "EDIT_NUM", "label": "Consigna", "variable": "consigna", "valueType": "float", "initial": 45, "min": 0, "max": 100, "step": 0.5, "decimals": 1, "unit": "C" },
            { "type": "EDIT_BOOL", "label": "Bomba", "variable": "bomba", "falseText": "PARADA", "trueText": "MARCHA" },
            { "type": "SUBMENU", "label": "Avanzado", "children": [
              { "type": "EDIT_NUM", "label": "Retardo", "variable": "retardo", "valueType": "int32", "initial": 30, "min": 0, "max": 600, "step": 5, "unit": "s" },
              { "type": "SUBMENU", "label": "Alarmas", "children": [
                { "type": "EDIT_NUM", "label": "Alta", "variable": "alarmaAlta", "valueType": "float", "initial": 80, "min": 0, "max": 150, "step": 1, "decimals": 0, "unit": "C" },
                { "type": "EDIT_BOOL", "label": "Habilitada", "variable": "alarmaHabilitada", "initial": 1, "falseText": "NO", "trueText": "SI" }
              ] }
            ] },
            { "type": "GO_IDLE", "label": "Salir al inicio" }
          ]
        }
      ]
    }
  ]
}
