{
    "formatVersion": "1.0",
    "package": {
        "id": "com.jwcontrol.jwplc-basic",
        "name": "JWPLC Basic OpenPLC",
        "version": "2.1.0-alpha.17",
        "vendor": {
            "name": "JW Control",
            "url": "https://www.jw-control.com",
            "logo": "assets/jwplcbasic.png"
        },
        "description": "Integración del JWPLC Basic 2.0.0 con OpenPLC Editor 4.3.3 (JWPLC Edition) usando el formato Vendor Plugin Package (.vpp).",
        "license": "GPL-3.0-or-later",
        "minEditorVersion": "4.3.3"
    },
    "devices": [
        {
            "id": "jwplc-basic-2-0-0",
            "name": "JWPLC BASIC [2.0.0]",
            "category": "Arduino",
            "preview": "assets/jwplcbasic.png",
            "screens": {
                "Serial": "screens/serial.json",
                "Network": "screens/network.json",
                "Backplane": "screens/backplane.json"
            },
            "serialPorts": [
                "Serial",
                "Serial2"
            ],
            "defaultSerial": "Serial",
            "networkInterfaces": [
                "Ethernet"
            ],
            "target": {
                "type": "arduino-cli",
                "core": "jwplc:esp32",
                "platform": "jwplc:esp32:jwplcbasic",
                "boardManagerUrl": "https://raw.githubusercontent.com/JW-Control/platform-jwplc/main/JWPLC/package_jwplc_index.json",
                "platformOptions": [
                    {
                        "key": "packageSource",
                        "label": "Package Source",
                        "default": "published",
                        "help": "Selecciona si OpenPLC compila con el package publicado/instalado o con el namespace local de desarrollo.",
                        "values": [
                            {
                                "id": "published",
                                "label": "Published / Installed",
                                "fqbn": "jwplc:esp32:jwplcbasic"
                            },
                            {
                                "id": "local",
                                "label": "Local Development",
                                "fqbn": "jwplc_local:esp32:jwplcbasic"
                            }
                        ]
                    }
                ]
            },
            "hal": {
                "type": "arduino",
                "source": "hal/jwplcbasic.cpp",
                "define": [
                    "JWPLC_BASIC",
                    "OPENPLC_JWPLC_BASIC",
                    "MBTCP_ETHERNET"
                ],
                "extraArduinoLibraries": []
            },
            "defaults": {
                "pins": {
                    "defaultDin": [
                        "I0_0",
                        "I0_1",
                        "I0_2",
                        "I0_3",
                        "I0_4",
                        "I0_5",
                        "I0_6",
                        "I0_7"
                    ],
                    "defaultDout": [
                        "Q0_0",
                        "Q0_1",
                        "Q0_2",
                        "Q0_3",
                        "Q0_4",
                        "Q0_5",
                        "Q0_6",
                        "Q0_7"
                    ],
                    "defaultAin": [],
                    "defaultAout": []
                }
            },
            "specs": {
                "CPU": "ESP32-WROOM-32E / 240 MHz",
                "RAM": "520 KB",
                "Flash": "4 MB",
                "Digital Pins": "8 DI + 8 DO",
                "Analog Pins": "No habilitado",
                "PWM Pins": "No habilitado",
                "WiFi": "Yes",
                "Bluetooth": "Yes",
                "Ethernet": "Yes - W5500",
                "RS-485": "Yes",
                "RTC": "Yes - DS3232",
                "FRAM": "Yes",
                "microSD": "Yes",
                "Display": "TFT ST7789",
                "Keyboard": "6 buttons"
            },
            "capabilities": {
                "pinMapping": true,
                "vppIo": true,
                "modbusTcpRemote": false,
                "ethercat": false,
                "modbusTcpServer": true,
                "opcuaServer": false,
                "s7Server": false,
                "debuggerTransports": [
                    "modbus-serial",
                    "modbus-tcp"
                ],
                "pythonFunctionBlocks": false,
                "arduinoApiCompletions": true,
                "hasRuntimeStats": false,
                "isInProcessSimulator": false,
                "directUsbUpload": true,
                "hmiDisplay": {
                    "controller": "ST7789",
                    "width": 320,
                    "height": 170,
                    "pixelFormat": "RGB565",
                    "keys": ["LEFT", "UP", "RIGHT", "ESC", "OK", "DOWN"]
                }
            },
            "debug": {
                "channels": [
                    {
                        "label": "USB (Serial)",
                        "channel": "rtu",
                        "enabledWhen": false,
                        "params": {
                            "port": {
                                "$ref": "configuration.communicationPort",
                                "required": "Selecciona el puerto COM del JWPLC Basic (USB) en Device."
                            },
                            "baudRate": {
                                "$ref": "screens.serial.baud_rate",
                                "default": "115200",
                                "as": "number"
                            },
                            "slaveId": 1
                        }
                    },
                    {
                        "label": "Modbus TCP / W5500",
                        "channel": "tcp",
                        "enabledWhen": {
                            "$ref": "screens.network.enabled"
                        },
                        "params": {
                            "ipAddress": {
                                "$ref": "screens.network.tcp_debug_ip_address",
                                "fallback": "screens.network.ip_address",
                                "required": "Configura la IP del JWPLC Basic para depuración por red. Si usas DHCP, usa JWPLC Device Discovery o coloca la IP asignada en Debug IP Address (Device > Network)."
                            }
                        }
                    }
                ]
            },
            "moduleSystem": {
                "enabled": true,
                "maxSlots": 8,
                "modules": [
                    {
                        "id": "jwplc-basic-controller",
                        "name": "JWPLC Basic v2.0.0",
                        "fixed": true,
                        "image": "assets/jwplcbasic.png",
                        "description": "Controlador principal JWPLC Basic v2.0.0 con I/O local, Ethernet W5500, RS-485, RTC, FRAM, microSD, display y botonera.",
                        "specs": {
                            "CPU": "ESP32-WROOM-32E / 240 MHz",
                            "I_O": "8 DI / 8 DO locales",
                            "Ethernet": "W5500",
                            "RS485": "Serial2",
                            "Role": "Main controller"
                        },
                        "io": {
