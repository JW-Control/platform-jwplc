{
  "sections": [
    {
      "id": "network",
      "title": "Network (Ethernet W5500)",
      "layout": "form",
      "collapsible": true,
      "collapsed": false,
      "fields": [
        {
          "id": "enabled",
          "label": "Enable Network",
          "type": "boolean",
          "default": false,
          "help": "Levanta el Ethernet W5500 del JWPLC Basic. Lo usan el servidor Modbus TCP del proyecto (Servers), el depurador por red y la búsqueda de equipos."
        },
        {
          "id": "interface",
          "label": "Interface",
          "type": "select",
          "options": [
            {
              "label": "Ethernet - W5500",
              "value": "Ethernet"
            }
          ],
          "default": "Ethernet",
          "visible": {
            "condition": "fields.enabled",
            "operator": "equals",
            "value": true
          }
        },
        {
          "id": "mac_address",
          "label": "MAC Address",
          "type": "mac-address",
          "default": "DE:AD:BE:EF:00:01",
          "placeholder": "DE:AD:BE:EF:00:01",
          "help": "MAC del W5500. Usa una distinta por equipo si hay varios JWPLC Basic en la misma red.",
          "visible": {
            "condition": "fields.enabled",
            "operator": "equals",
            "value": true
          }
        },
        {
          "id": "enable_dhcp",
          "label": "Use DHCP",
          "type": "boolean",
          "default": true,
          "help": "Sin DHCP, los campos de IP estática de abajo son obligatorios.",
          "visible": {
            "condition": "fields.enabled",
            "operator": "equals",
            "value": true
          }
        },
        {
          "id": "tcp_device_discovery",
          "label": "JWPLC Device Discovery",
          "type": "jwplc-device-discovery",
          "default": "",
          "help": "Busca equipos JWPLC/OpenPLC en la red local y permite usar su IP para depuración.",
          "visible": {
            "condition": "fields.enabled",
            "operator": "equals",
            "value": true
          }
        },
        {
          "id": "tcp_debug_ip_address",
          "label": "Debug IP Address",
          "type": "ip-address",
          "default": "",
          "placeholder": "Ej. 192.168.0.50",
          "help": "IP usada por el depurador Modbus TCP. Si queda vacía, se usa IP Address. Con DHCP, coloca aquí la IP detectada.",
          "visible": {
            "condition": "fields.enabled",
            "operator": "equals",
            "value": true
          }
        },
        {
          "id": "ip_address",
          "label": "IP Address",
          "type": "ip-address",
          "default": "",
          "placeholder": "192.168.0.10",
          "visible": {
            "operator": "and",
            "conditions": [
              {
                "condition": "fields.enabled",
                "operator": "equals",
                "value": true
              },
              {
                "condition": "fields.enable_dhcp",
                "operator": "equals",
                "value": false
              }
            ]
          }
        },
        {
          "id": "gateway",
          "label": "Gateway",
          "type": "ip-address",
          "default": "",
          "placeholder": "192.168.0.1",
          "visible": {
            "operator": "and",
            "conditions": [
              {
                "condition": "fields.enabled",
                "operator": "equals",
                "value": true
              },
              {
                "condition": "fields.enable_dhcp",
                "operator": "equals",
                "value": false
              }
            ]
          }
        },
        {
          "id": "subnet",
          "label": "Subnet Mask",
          "type": "ip-address",
          "default": "",
          "placeholder": "255.255.255.0",
          "visible": {
            "operator": "and",
            "conditions": [
              {
                "condition": "fields.enabled",
                "operator": "equals",
                "value": true
              },
              {
                "condition": "fields.enable_dhcp",
                "operator": "equals",
                "value": false
              }
            ]
          }
        },
        {
          "id": "dns",
          "label": "DNS",
          "type": "ip-address",
          "default": "",
          "placeholder": "8.8.8.8",
          "visible": {
            "operator": "and",
            "conditions": [
              {
                "condition": "fields.enabled",
                "operator": "equals",
                "value": true
              },
              {
                "condition": "fields.enable_dhcp",
                "operator": "equals",
                "value": false
              }
            ]
          }
        }
      ]
    }
  ]
}
